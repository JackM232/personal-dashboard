// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// CORE — add a relation field here for each new module
// ─────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leetcodeEntries    LeetCodeEntry[]
  applications       InternshipApplication[]
  workoutSessions    WorkoutSession[]
  bodyweightEntries  BodyweightEntry[]
  cookLogs           CookLog[]
  recipeFavorites    RecipeFavorite[]
  investmentAccounts InvestmentAccount[]
  watchlistItems     WatchlistItem[]
  projects           Project[]
  taskLists          TaskList[]
  tasks              Task[]
  dashboardLayout    DashboardLayout?
}

// ─────────────────────────────────────────
// MODULE: LeetCode Tracker
// ─────────────────────────────────────────

model LeetCodeProblem {
  id         String     @id @default(cuid())
  number     Int        @unique
  name       String     @unique
  difficulty Difficulty
  topicTag   TopicTag
  createdAt  DateTime   @default(now())

  entries LeetCodeEntry[]

  @@map("leetcode_problems")
}

model LeetCodeEntry {
  id           String   @id @default(cuid())
  userId       String
  problemId    String
  status       Status   @default(UNATTEMPTED)
  hintsUsed    Int      @default(0) // range 0–4; enforced at the service layer
  videoWatched Boolean  @default(false)
  timeTaken    Int? // minutes; null until the user logs time
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem LeetCodeProblem @relation(fields: [problemId], references: [id], onDelete: Restrict)

  @@unique([userId, problemId])
  @@map("leetcode_entries")
}

// ─────────────────────────────────────────
// MODULE: Internship Applications
// ─────────────────────────────────────────

model InternshipApplication {
  id        String            @id @default(cuid())
  userId    String
  company   String
  position  String
  location  String?
  workMode  WorkMode?
  url       String?
  source    String? // where you found it — referral, Handshake, careers page
  appliedAt DateTime? // null while status is SAVED
  status    ApplicationStatus @default(SAVED)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@index([userId])
  @@map("internship_applications")
}

model Interview {
  id            String           @id @default(cuid())
  applicationId String
  scheduledAt   DateTime
  stage         InterviewStage   @default(PHONE_SCREEN)
  format        InterviewFormat?
  interviewer   String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  application InternshipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("interviews")
}

// ─────────────────────────────────────────
// MODULE: Gym Progress
// ─────────────────────────────────────────

model Exercise {
  id               String        @id @default(cuid())
  name             String        @unique
  equipment        EquipmentType
  primaryMuscles   MuscleGroup[]
  secondaryMuscles MuscleGroup[]
  isUnilateral     Boolean       @default(false)
  description      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  workoutExercises WorkoutExercise[]

  @@map("exercises")
}

model WorkoutSession {
  id          String   @id @default(cuid())
  userId      String
  performedAt DateTime // normalized to UTC midnight — date-only
  name        String? // "Push Day A"
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]

  @@index([userId, performedAt])
  @@map("workout_sessions")
}

model WorkoutExercise {
  id         String   @id @default(cuid())
  sessionId  String
  exerciseId String
  position   Int      @default(0) // display order within the session
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets     WorkoutSet[]

  @@index([sessionId])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model WorkoutSet {
  id                String   @id @default(cuid())
  workoutExerciseId String
  setNumber         Int
  reps              Int
  weight            Float? // null = bodyweight / unloaded
  isWarmup          Boolean  @default(false)
  createdAt         DateTime @default(now())

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutExerciseId, setNumber])
  @@map("workout_sets")
}

model BodyweightEntry {
  id         String   @id @default(cuid())
  userId     String
  recordedAt DateTime // normalized to UTC midnight — one entry per day
  weight     Float
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recordedAt])
  @@index([userId])
  @@map("bodyweight_entries")
}

// ─────────────────────────────────────────
// MODULE: Recipes
// ─────────────────────────────────────────

model Recipe {
  id           String           @id @default(cuid())
  name         String           @unique
  description  String?
  mealType     MealType
  cuisine      Cuisine          @default(OTHER)
  difficulty   RecipeDifficulty @default(EASY)
  prepMinutes  Int              @default(0) // total time = prep + cook, derived in the UI
  cookMinutes  Int              @default(0)
  servings     Int              @default(2)
  calories     Int? // per serving; null until someone works it out
  proteinGrams Int?
  carbGrams    Int?
  fatGrams     Int?
  tags         RecipeTag[] // dietary / convenience flags, used for filtering
  sourceUrl    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  ingredients RecipeIngredient[]
  steps       RecipeStep[]
  cookLogs    CookLog[]
  favorites   RecipeFavorite[]

  @@map("recipes")
}

model RecipeIngredient {
  id       String           @id @default(cuid())
  recipeId String
  position Int // 0-based display order; reassigned from array index on write
  quantity Float? // null for "to taste" / "a handful"
  unit     MeasurementUnit?
  name     String
  note     String? // "finely diced", "room temperature"

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, position])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id          String @id @default(cuid())
  recipeId    String
  position    Int
  instruction String
  minutes     Int? // optional per-step timing badge

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, position])
  @@map("recipe_steps")
}

model CookLog {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  cookedAt  DateTime // normalized to UTC midnight — date-only
  rating    Int? // range 1–5; enforced in the controller
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  @@index([userId, cookedAt])
  @@index([recipeId])
  @@map("cook_logs")
}

model RecipeFavorite {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@map("recipe_favorites")
}

// ─────────────────────────────────────────
// MODULE: Investments
// ─────────────────────────────────────────

model InvestmentAccount {
  id          String      @id @default(cuid())
  userId      String
  name        String
  type        AccountType
  institution String? // "Fidelity", "Schwab" — free text, not an enum
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions InvestmentTransaction[]

  @@unique([userId, name])
  @@index([userId])
  @@map("investment_accounts")
}

// Transactions are the source of truth — positions, cost basis and returns are
// all derived from this ledger (see src/modules/investments/positions.ts). There
// is deliberately no flat holdings table to drift out of sync with it.
model InvestmentTransaction {
  id            String          @id @default(cuid())
  accountId     String
  symbol        String // always uppercase; normalized in the controller
  type          TransactionType
  tradedAt      DateTime // normalized to UTC midnight — date-only
  quantity      Float // shares; for DIVIDEND, the shares the payout covered
  pricePerShare Float // for DIVIDEND, the per-share payout
  fees          Float           @default(0)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Deleting an account is guarded by a 409 in the controller while it still has
  // transactions; the cascade is the backstop for a user deletion.
  account InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([accountId, symbol])
  @@map("investment_transactions")
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  position  Int      @default(0) // display order in the watchlist strip
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
  @@map("watchlist_items")
}

// ─────────────────────────────────────────
// MODULE: Coding Projects
// ─────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  userId      String
  name        String
  description String?
  kind        ProjectKind   @default(OTHER)
  status      ProjectStatus @default(IDEA)
  // Free text rather than an enum — the set of things worth naming here grows
  // every time you start a project, and an enum would need a migration each time.
  techStack   String[]
  repoUrl     String?
  liveUrl     String?
  startedAt   DateTime? // null while the project is still an IDEA
  completedAt DateTime? // set when status becomes SHIPPED; cleared if it reopens
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones ProjectMilestone[]

  @@unique([userId, name])
  @@index([userId])
  @@map("projects")
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  targetDate  DateTime? // normalized to UTC midnight — date-only
  completedAt DateTime? // null means outstanding; the tab splits on this
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_milestones")
}

// ─────────────────────────────────────────
// MODULE: Tasks
// ─────────────────────────────────────────

model TaskList {
  id        String   @id @default(cuid())
  userId    String
  // Optional: a list is usually "the list for a given day" and needs no name of
  // its own. The client falls back to the formatted date when this is null.
  title     String?
  date      DateTime // normalized to UTC midnight — date-only
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId, date])
  @@map("task_lists")
}

model Task {
  id       String       @id @default(cuid())
  userId   String
  // Null is the "unsorted" bucket, not a missing value — a task is allowed to
  // exist before you decide which day it belongs to.
  listId   String?
  title    String
  done     Boolean      @default(false)
  priority TaskPriority @default(MEDIUM)
  dueDate  DateTime? // normalized to UTC midnight — date-only

  // Reserved for linking a task to a row in another module (an application, a
  // project). Deliberately a loose module-name/id pair rather than a real
  // relation: a foreign key would have to name one module, and this needs to
  // reach several. Nothing reads or writes these yet — the API does not accept
  // them — so the shape is still free to change when it is implemented.
  linkedModule String?
  linkedItemId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting a list is a way of tidying up, and it must
  // not silently take the still-outstanding tasks on it with it. They fall back
  // to unsorted, where they stay visible.
  list TaskList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  @@index([userId, done])
  @@index([listId])
  @@map("tasks")
}

// ─────────────────────────────────────────
// MODULE: Dashboard home page
// ─────────────────────────────────────────

// How one user has arranged the home page's preview cards. Deliberately opaque
// string ids rather than an enum: the server has no idea which previews exist,
// so adding an eighth one is a frontend-only change. The client reconciles what
// it reads here against its own catalog — see previews.tsx.
model DashboardLayout {
  id        String   @id @default(cuid())
  // One row per user, upserted on this — there is no second arrangement to keep.
  userId    String   @unique
  order     String[] // preview ids, in display order
  hidden    String[] // preview ids the user has turned off
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dashboard_layouts")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  USER
  CONTRIBUTOR
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Status {
  UNATTEMPTED
  STARTED
  COMPLETED
}

enum ApplicationStatus {
  SAVED
  APPLIED
  ONLINE_ASSESSMENT
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum InterviewStage {
  PHONE_SCREEN
  ONLINE_ASSESSMENT
  TECHNICAL
  BEHAVIORAL
  SYSTEM_DESIGN
  ONSITE
  FINAL
}

enum InterviewFormat {
  PHONE
  VIDEO
  ONSITE
}

enum MuscleGroup {
  UPPER_CHEST
  MID_CHEST
  LOWER_CHEST
  FRONT_DELT
  SIDE_DELT
  REAR_DELT
  LATS
  TRAPS
  RHOMBOIDS
  LOWER_BACK
  BICEPS
  TRICEPS
  FOREARMS
  UPPER_ABS
  LOWER_ABS
  OBLIQUES
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
}

enum EquipmentType {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  BAND
  OTHER
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  DESSERT
  SIDE
  DRINK
}

enum Cuisine {
  AMERICAN
  ITALIAN
  MEXICAN
  CHINESE
  JAPANESE
  KOREAN
  INDIAN
  THAI
  MEDITERRANEAN
  FRENCH
  MIDDLE_EASTERN
  OTHER
}

// Recipes keep their own difficulty scale rather than sharing the LeetCode
// `Difficulty` enum — modules stay independent of each other's vocabulary.
enum RecipeDifficulty {
  EASY
  MEDIUM
  HARD
}

enum RecipeTag {
  HIGH_PROTEIN
  LOW_CARB
  HIGH_CARB
  HIGH_FIBER
  LOW_CALORIE
  VEGETARIAN
  VEGAN
  GLUTEN_FREE
  DAIRY_FREE
  MEAL_PREP
  ONE_POT
  QUICK
  BUDGET
  SPICY
}

enum MeasurementUnit {
  G
  KG
  ML
  L
  TSP
  TBSP
  CUP
  OZ
  LB
  PIECE
  CLOVE
  SLICE
  PINCH
  CAN
  BUNCH
  TO_TASTE
}

enum AccountType {
  BROKERAGE
  ROTH_IRA
  TRADITIONAL_IRA
  RETIREMENT_401K
  HSA
  CRYPTO
  OTHER
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
}

// Ordered as a project moves through it — SortableTable's "enum" columns sort by
// declaration order, so this doubles as the pipeline order in the UI.
enum ProjectStatus {
  IDEA
  PLANNING
  IN_PROGRESS
  PAUSED
  SHIPPED
  ARCHIVED
}

enum ProjectKind {
  WEB_APP
  MOBILE_APP
  CLI
  LIBRARY
  API
  GAME
  DATA
  MACHINE_LEARNING
  AUTOMATION
  OTHER
}

enum TopicTag {
  ARRAY
  STRING
  LINKED_LIST
  STACK
  QUEUE
  HASH_MAP
  TWO_POINTERS
  SLIDING_WINDOW
  BINARY_SEARCH
  TREE
  TRIE
  HEAP
  GRAPH
  BACKTRACKING
  DYNAMIC_PROGRAMMING
  GREEDY
  INTERVALS
  MATRIX
  BIT_MANIPULATION
  MATH
}

// Declaration order is priority order, high last — the frontend sorts on the
// position of the value in this list.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}
